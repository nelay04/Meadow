# Copy to .env and adjust. Compose reads this file automatically; the API reads the
# MEADOW_-prefixed keys from the same file via pydantic-settings.

# --- Postgres ---
POSTGRES_USER=meadow
POSTGRES_PASSWORD=meadow
POSTGRES_DB=meadow
POSTGRES_PORT=5435

# --- Redis ---
# 6380 on the host by default: a native redis commonly owns 6379 already.
REDIS_PORT=6380

# Project-allocated ports. Keep these in sync with whatever the host allows.
API_PORT=8012
WEB_PORT=3012
PGADMIN_PORT=5051

# --- pgAdmin (dev only) ---
PGADMIN_EMAIL=dev@meadow.dev
PGADMIN_PASSWORD=meadow

# --- API ---
MEADOW_DATABASE_URL=postgresql+asyncpg://meadow:meadow@localhost:5435/meadow
MEADOW_REDIS_URL=redis://localhost:6380/0

# Signs both the access JWT and the ws-token. Dev value; generate a real one for any
# deployed environment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MEADOW_JWT_SECRET=dev-only-not-a-real-secret-change-me
MEADOW_ACCESS_TOKEN_TTL_SECONDS=900
MEADOW_REFRESH_TOKEN_TTL_DAYS=30
# Set true behind https. False only so the plain-http dev server works.
MEADOW_REFRESH_COOKIE_SECURE=false

MEADOW_WS_TOKEN_TTL_SECONDS=60
MEADOW_WS_REVALIDATE_INTERVAL_SECONDS=900
MEADOW_MAX_CLIENTS_PER_ROOM=50

MEADOW_RATE_LIMIT_ENABLED=true
