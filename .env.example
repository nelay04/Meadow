# Copy to .env and adjust. Compose reads this file automatically; the API reads the
# MEADOW_-prefixed keys from the same file via pydantic-settings.

# --- Postgres ---
POSTGRES_USER=meadow
POSTGRES_PASSWORD=meadow
POSTGRES_DB=meadow
POSTGRES_PORT=5435

# --- Redis ---
# 6382 on the host, and loopback-bound. A native redis commonly owns 6379, and 6380 is
# the obvious second choice, so another project's compose stack tends to hold it.
# Only things running outside the compose network use it - pytest, the gate and the e2e
# scripts on the host. The api and worker containers reach redis at redis://redis:6379.
REDIS_PORT=6382

# Project-allocated ports, published by the api and web containers. Keep these in sync
# with whatever the host allows. The scripts that start servers of their own do not use
# them: the M0 gate takes 8013, board-e2e 8014/3094, presence-e2e 8016/3097.
API_PORT=8012
WEB_PORT=3012
PGADMIN_PORT=5051

# --- pgAdmin (dev only) ---
PGADMIN_EMAIL=dev@meadow.dev
PGADMIN_PASSWORD=meadow

# --- API ---
MEADOW_DATABASE_URL=postgresql+asyncpg://meadow:meadow@localhost:5435/meadow
MEADOW_REDIS_URL=redis://localhost:6382/0

# Signs both the access JWT and the ws-token. Dev value; generate a real one for any
# deployed environment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MEADOW_JWT_SECRET=dev-only-not-a-real-secret-change-me
MEADOW_ACCESS_TOKEN_TTL_SECONDS=900
MEADOW_REFRESH_TOKEN_TTL_DAYS=30
# Set true behind https. False only so the plain-http dev server works.
MEADOW_REFRESH_COOKIE_SECURE=false

MEADOW_WS_TOKEN_TTL_SECONDS=60
MEADOW_WS_REVALIDATE_INTERVAL_SECONDS=900
MEADOW_MAX_CLIENTS_PER_ROOM=50

# How long a deleted glade or lea - and a page torn out of a lea - stays in the trash
# before it is deleted for good. 720 hours is 30 days. The worker sweeps hourly, so a
# board is purged within the hour after its window passes, never before. Set it to 0
# to make deleting final at once.
MEADOW_TRASH_RETENTION_HOURS=720

MEADOW_RATE_LIMIT_ENABLED=true

# --- GitHub sign-in ---
# Optional. Leave both blank and the API reports the provider as unavailable, the web
# app hides the GitHub button, and /api/v1/auth/github/* answers 404 - a deployment
# without an OAuth app is a supported configuration, not a broken one.
#
# To fill it in: github.com/settings/developers -> New OAuth App
#   Homepage URL:               http://localhost:3012
#   Authorization callback URL: http://localhost:3012/api/v1/auth/github/callback
# The callback below must match what you registered there character for character.
#
# The secret is a credential. It stays in this gitignored file, is read by the API
# only, and is never sent to the browser.
MEADOW_GITHUB_CLIENT_ID=
MEADOW_GITHUB_CLIENT_SECRET=
MEADOW_GITHUB_CALLBACK_URL=http://localhost:3012/api/v1/auth/github/callback

# --- Google sign-in ---
# Same deal, independently: blank means the Google button is not offered at all.
#
# To fill it in: console.cloud.google.com -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application
#   Authorised JavaScript origin:  http://localhost:3012
#   Authorised redirect URI:       http://localhost:3012/api/v1/auth/google/callback
# Google matches the redirect URI exactly and refuses at the consent screen, not at the
# exchange, so a mismatch fails before the user ever sees Meadow again.
MEADOW_GOOGLE_CLIENT_ID=
MEADOW_GOOGLE_CLIENT_SECRET=
MEADOW_GOOGLE_CALLBACK_URL=http://localhost:3012/api/v1/auth/google/callback

# --- activation mail ---
# A registration is not finished until the address answers: the account exists but
# cannot be signed in to until the link in this mail is followed.
#
# Leave MEADOW_SMTP_HOST blank and accounts are created already activated. That is a
# development convenience and the API logs a warning every time it takes that path;
# a production deployment with this blank is a misconfiguration, not a choice.
#
# The password is a credential. It stays in this gitignored file, is read by the API
# only, and is never sent to the browser.
MEADOW_SMTP_HOST=
MEADOW_SMTP_PORT=587
MEADOW_SMTP_USER=
MEADOW_SMTP_PASSWORD=
# The From address. Often the same as the user, but a relay may authenticate as one
# identity and send as another.
MEADOW_SMTP_FROM=
MEADOW_SMTP_FROM_NAME=Meadow
# STARTTLS on 587. For implicit TLS on 465, set MEADOW_SMTP_SSL=true instead.
MEADOW_SMTP_STARTTLS=true
MEADOW_SMTP_SSL=false
# How long an activation link stays good.
MEADOW_ACTIVATION_TTL_HOURS=24

# Where the callback sends the browser once a session exists, and the only origin any
# post-login redirect may point at.
MEADOW_WEB_BASE_URL=http://localhost:3012
# How long a half-finished sign-in stays valid.
MEADOW_OAUTH_STATE_TTL_SECONDS=600

# --- Running the app in docker (docker-compose.local.yml) ---
# Set true if an edit does not trigger a reload. Bind mounts on WSL and on
# docker-for-mac often do not deliver inotify events into a container, so the watchers
# see nothing. Polling always works and costs CPU forever, which is why it is off.
MEADOW_WATCH_POLL=false
