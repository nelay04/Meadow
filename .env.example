# Copy to .env and adjust. Compose reads this file automatically; the API reads the
# MEADOW_-prefixed keys from the same file via pydantic-settings.

# --- Postgres ---
POSTGRES_USER=meadow
POSTGRES_PASSWORD=meadow
POSTGRES_DB=meadow
POSTGRES_PORT=5435

# --- Redis ---
# 6380 on the host by default: a native redis commonly owns 6379 already.
REDIS_PORT=6380

# Project-allocated ports. Keep these in sync with whatever the host allows.
API_PORT=8012
WEB_PORT=3012
PGADMIN_PORT=5051

# --- pgAdmin (dev only) ---
PGADMIN_EMAIL=dev@meadow.dev
PGADMIN_PASSWORD=meadow

# --- API ---
MEADOW_DATABASE_URL=postgresql+asyncpg://meadow:meadow@localhost:5435/meadow
MEADOW_REDIS_URL=redis://localhost:6380/0

# Signs both the access JWT and the ws-token. Dev value; generate a real one for any
# deployed environment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MEADOW_JWT_SECRET=dev-only-not-a-real-secret-change-me
MEADOW_ACCESS_TOKEN_TTL_SECONDS=900
MEADOW_REFRESH_TOKEN_TTL_DAYS=30
# Set true behind https. False only so the plain-http dev server works.
MEADOW_REFRESH_COOKIE_SECURE=false

MEADOW_WS_TOKEN_TTL_SECONDS=60
MEADOW_WS_REVALIDATE_INTERVAL_SECONDS=900
MEADOW_MAX_CLIENTS_PER_ROOM=50

MEADOW_RATE_LIMIT_ENABLED=true

# --- GitHub sign-in ---
# Optional. Leave both blank and the API reports the provider as unavailable, the web
# app hides the GitHub button, and /api/v1/auth/github/* answers 404 - a deployment
# without an OAuth app is a supported configuration, not a broken one.
#
# To fill it in: github.com/settings/developers -> New OAuth App
#   Homepage URL:               http://localhost:3012
#   Authorization callback URL: http://localhost:3012/api/v1/auth/github/callback
# The callback below must match what you registered there character for character.
#
# The secret is a credential. It stays in this gitignored file, is read by the API
# only, and is never sent to the browser.
MEADOW_GITHUB_CLIENT_ID=
MEADOW_GITHUB_CLIENT_SECRET=
MEADOW_GITHUB_CALLBACK_URL=http://localhost:3012/api/v1/auth/github/callback
# Where the callback sends the browser once a session exists, and the only origin any
# post-login redirect may point at.
MEADOW_WEB_BASE_URL=http://localhost:3012
# How long a half-finished sign-in stays valid.
MEADOW_OAUTH_STATE_TTL_SECONDS=600

# --- Running the app in docker (docker-compose.local.yml --profile app) ---
# Set true if an edit does not trigger a reload. Bind mounts on WSL and on
# docker-for-mac often do not deliver inotify events into a container, so the watchers
# see nothing. Polling always works and costs CPU forever, which is why it is off.
MEADOW_WATCH_POLL=false
