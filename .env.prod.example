# Copy to .env.prod on the VPS and fill in. Never commit the result.
#
#   docker compose --env-file .env.prod up -d
#
# The development .env is a different file with different values, and the two are not
# interchangeable: the dev one points at localhost ports that do not exist inside the
# compose network.

# --- Postgres ---
# No host port. Nothing outside the compose network connects to it.
POSTGRES_USER=meadow
POSTGRES_PASSWORD=
POSTGRES_DB=meadow

# --- API ---
# Signs both the access JWT and the ws-token. Rotating it logs everyone out, which is
# the correct behaviour if it ever leaks.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MEADOW_JWT_SECRET=

MEADOW_ACCESS_TOKEN_TTL_SECONDS=900
MEADOW_REFRESH_TOKEN_TTL_DAYS=30
# True in production. The refresh cookie is the long-lived credential; over plain http
# it is readable by anything on the path.
MEADOW_REFRESH_COOKIE_SECURE=true

MEADOW_WS_TOKEN_TTL_SECONDS=60
MEADOW_WS_REVALIDATE_INTERVAL_SECONDS=900
MEADOW_MAX_CLIENTS_PER_ROOM=50

# How long a deleted glade or lea - and a page torn out of a lea - stays in the trash
# before it is deleted for good. 720 hours is 30 days. The worker sweeps hourly, so a
# board is purged within the hour after its window passes, never before. Set it to 0
# to make deleting final at once.
MEADOW_TRASH_RETENTION_HOURS=720
MEADOW_RATE_LIMIT_ENABLED=true

# --- GitHub sign-in ---
# Optional, and off when blank: the button disappears rather than leading to an error.
#
# Register the OAuth app at github.com/settings/developers with the *public* URLs, and
# make MEADOW_GITHUB_CALLBACK_URL match the registered callback exactly - GitHub
# refuses the exchange on any difference.
#
#   MEADOW_GITHUB_CLIENT_ID=
#   MEADOW_GITHUB_CLIENT_SECRET=
#   MEADOW_GITHUB_CALLBACK_URL=https://meadow.example.com/api/v1/auth/github/callback
#
# --- Google sign-in ---
# Optional and independent of the one above: run either, both, or neither.
#
# Create the OAuth client at console.cloud.google.com under APIs & Services ->
# Credentials, as a Web application, with the *public* URLs:
#
#   MEADOW_GOOGLE_CLIENT_ID=
#   MEADOW_GOOGLE_CLIENT_SECRET=
#   MEADOW_GOOGLE_CALLBACK_URL=https://meadow.example.com/api/v1/auth/google/callback
#
# The redirect URI has to be listed on the client verbatim. Google refuses at the
# consent screen rather than at the exchange, so a mismatch fails before the user gets
# back to the site at all.
#
# --- activation mail ---
# Required in production: without it every account is created already activated, which
# means an address nobody has proved can hold an account, and the API warns about it on
# every registration.
#
#   MEADOW_SMTP_HOST=smtp.example.com
#   MEADOW_SMTP_PORT=587
#   MEADOW_SMTP_USER=no-reply@meadow.example.com
#   MEADOW_SMTP_PASSWORD=
#   MEADOW_SMTP_FROM=no-reply@meadow.example.com
#   MEADOW_SMTP_FROM_NAME=Meadow
#   MEADOW_SMTP_STARTTLS=true      # or MEADOW_SMTP_SSL=true on port 465
#   MEADOW_ACTIVATION_TTL_HOURS=24
#
# The activation link is built from MEADOW_WEB_BASE_URL below, so that has to be the
# public origin or the mail will point somewhere unreachable.
#
# The public origin of the site. The OAuth callback builds every redirect from this
# value plus a path it chose itself, so it is also what stops the callback being used
# as an open redirect. Required whenever the two above are set.
#   MEADOW_WEB_BASE_URL=https://meadow.example.com
MEADOW_OAUTH_STATE_TTL_SECONDS=600

# --- Edge ---
# Where the stack listens on the host. Loopback because the host's TLS terminator
# proxies to it; set WEB_BIND=0.0.0.0 only if this container is itself the edge.
WEB_BIND=127.0.0.1
WEB_PUBLIC_PORT=8080

# Whose X-Forwarded-For nginx believes.
#
# Leave it at 127.0.0.1 when this container is the edge and browsers connect to the
# published port directly: nothing arriving over the docker bridge can match, so the
# header is ignored and the TCP peer is the client.
#
# Set it to 172.28.0.1, the bridge gateway, when a TLS terminator on the host proxies
# to the published port - otherwise every visitor shares one rate-limit bucket and one
# audit-log address, because the peer is always the terminator. That terminator must
# append to X-Forwarded-For rather than overwrite it, which is what
# `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for` does and is the
# default in most guides.
MEADOW_TRUSTED_PROXY_CIDR=127.0.0.1

# --- Images ---
# Left unset, compose builds locally and tags them meadow-api:local and friends,
# which is what you want on a development machine. On the VPS set all three: the
# deploy runs `docker compose pull`, and an unset value leaves it trying to pull a
# tag named `:local` that was never pushed anywhere.
#
# Every image is also tagged with its commit sha, so a rollback is an edit here and an
# `up -d` rather than a revert and a rebuild.
# MEADOW_API_IMAGE=ghcr.io/<owner>/meadow-api:latest
# MEADOW_WEB_IMAGE=ghcr.io/<owner>/meadow-web:latest
# MEADOW_BACKUP_IMAGE=ghcr.io/<owner>/meadow-backup:latest

# --- Backups ---
BACKUP_DIR=./backups
BACKUP_SCHEDULE=@daily
# The dump files are written as this user. Match it to whoever needs to read them off
# the host, or the backups are root-owned and awkward to copy.
BACKUP_UID=1000
BACKUP_GID=1000
