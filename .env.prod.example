# Copy to .env.prod on the VPS and fill in the blanks. Never commit the result.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#   docker compose --env-file .env.prod up -d --build --wait
#
# The development .env is a different file with different values. The dev one points at
# localhost ports that do not exist inside the compose network.

# --- Postgres ---
# No host port. Nothing outside the compose network connects to it.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=meadow
POSTGRES_PASSWORD=
POSTGRES_DB=meadow

# --- API ---
# Signs both the access JWT and the ws-token. Rotating it logs everyone out.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MEADOW_JWT_SECRET=

MEADOW_ACCESS_TOKEN_TTL_SECONDS=900
MEADOW_REFRESH_TOKEN_TTL_DAYS=30
# True behind https. Over plain http the browser never sends the cookie back, so
# sign-in appears to work and then drops you on the next page load.
MEADOW_REFRESH_COOKIE_SECURE=true

MEADOW_WS_TOKEN_TTL_SECONDS=60
# How long a board's password stays proved for once somebody has typed it.
# Per browser tab, and changing the board's password retires every one
# immediately, so this is the ceiling rather than the mechanism.
MEADOW_BOARD_PASS_TTL_SECONDS=43200
MEADOW_WS_REVALIDATE_INTERVAL_SECONDS=900
MEADOW_MAX_CLIENTS_PER_ROOM=50

# How long a deleted glade or lea stays recoverable. 720 hours is 30 days. Zero makes
# a delete final at once.
MEADOW_TRASH_RETENTION_HOURS=720
MEADOW_RATE_LIMIT_ENABLED=true

# The public origin. Every post-login redirect is built from this, which is what stops
# the OAuth callback being used as an open redirect. Activation mail links here too.
MEADOW_WEB_BASE_URL=
MEADOW_OAUTH_STATE_TTL_SECONDS=600

# --- GitHub sign-in ---
# Blank client id means the provider is reported unavailable and the button is hidden,
# which is a supported configuration. github.com/settings/developers -> New OAuth App.
# The callback must match what you registered there character for character.
MEADOW_GITHUB_CLIENT_ID=
MEADOW_GITHUB_CLIENT_SECRET=
MEADOW_GITHUB_CALLBACK_URL=

# --- Google sign-in ---
# Same, and independent of GitHub. console.cloud.google.com -> APIs & Services ->
# Credentials -> OAuth client ID -> Web application. Google matches the redirect URI
# exactly and refuses at the consent screen, so a mismatch fails before the exchange.
MEADOW_GOOGLE_CLIENT_ID=
MEADOW_GOOGLE_CLIENT_SECRET=
MEADOW_GOOGLE_CALLBACK_URL=

# --- activation mail ---
# Blank host means accounts are created already activated, which is a development
# convenience and wrong here: fill these in.
MEADOW_SMTP_HOST=
MEADOW_SMTP_PORT=587
MEADOW_SMTP_USER=
MEADOW_SMTP_PASSWORD=
MEADOW_SMTP_FROM=
MEADOW_SMTP_FROM_NAME=Meadow
# STARTTLS on 587. For implicit TLS on 465 set SSL true and STARTTLS false.
MEADOW_SMTP_STARTTLS=true
MEADOW_SMTP_SSL=false
MEADOW_ACTIVATION_TTL_HOURS=24

# --- Edge ---
# Where the stack listens on the host. Loopback because the host's TLS terminator
# proxies to it; set WEB_BIND=0.0.0.0 only if this container is itself the edge.
WEB_BIND=127.0.0.1
WEB_PUBLIC_PORT=8080

# Whose X-Forwarded-For nginx believes. Leave at 127.0.0.1 when browsers reach the
# published port directly. Set it to 172.28.0.1, the bridge gateway, once a TLS
# terminator on the host proxies to it, or every visitor shares one rate-limit bucket
# because the peer is always the terminator.
MEADOW_TRUSTED_PROXY_CIDR=127.0.0.1

# --- Backups ---
# Absolute and outside the checkout: the deploy runs `git reset --hard` in the project
# directory, and recovery media does not belong in a tree a deploy rewrites.
#   mkdir -p /srv/meadow-backups && chmod 700 /srv/meadow-backups
BACKUP_DIR=/srv/meadow-backups
BACKUP_KEEP_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
# The uid the dump files are owned by. 0 is right when root is the only account that
# needs to read them off the host.
BACKUP_UID=0
BACKUP_GID=0
