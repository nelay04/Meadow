# The Meadow site. Serves the static landing page at /, the built SPA at /app, and
# proxies /api and /ws to the API container.
# This is a template, not a plain conf: the nginx image's entrypoint runs envsubst over
# /etc/nginx/templates/*.template into /etc/nginx/conf.d/. NGINX_ENVSUBST_FILTER is set
# to MEADOW_ in the compose file so only the variables below are substituted and
# nginx's own $host, $remote_addr, $uri and friends survive untouched.
#
# Substituted:
#   MEADOW_API_UPSTREAM         host:port of the API container
#   MEADOW_TRUSTED_PROXY_CIDR   who is allowed to tell us the client's real address

upstream meadow_api {
    server ${MEADOW_API_UPSTREAM};
    keepalive 32;
}

# Preserve the original scheme across two hops. When TLS is terminated in front of this
# container the request arrives over plain http, and passing $scheme would tell the API
# the session was insecure - which is what decides whether the refresh cookie may be
# marked Secure.
map $http_x_forwarded_proto $meadow_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Any redirect nginx generates itself is relative. It builds an absolute one from
    # $scheme, and TLS is terminated in front of this container, so an absolute redirect
    # sends an https visitor to an http URL - which the browser then blocks or downgrades.
    absolute_redirect off;

    # Thumbnails are webp captured from the canvas, a few hundred KB at most. The
    # default 1m would truncate a large board's capture into a 413.
    client_max_body_size 8m;

    # Who is allowed to tell us the client's real address.
    #
    # Defaults to 127.0.0.1, which nothing arriving over the docker bridge can match,
    # so X-Forwarded-For is ignored entirely and $remote_addr stays the TCP peer. That
    # is the correct answer when this container is the edge, and it fails closed: the
    # wrong setting costs accuracy, never authority.
    #
    # Set MEADOW_TRUSTED_PROXY_CIDR to the bridge gateway when a TLS terminator on the
    # host proxies to the published port. Without it, $remote_addr is the terminator
    # and every visitor shares one rate-limit bucket and one audit-log address.
    set_real_ip_from ${MEADOW_TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;

    # off, not on, and this is the part that matters.
    #
    # X-Forwarded-For is a client-supplied header that proxies append to. `on` walks
    # the list right to left and stops at the first address not in set_real_ip_from,
    # which sounds stricter and is the opposite: a caller who sends the header
    # themselves puts an address of their choosing at the far left, and with a single
    # trusted hop that forged entry is what the walk lands on. `off` takes the last
    # entry, which is the one the terminator appended and the only one no client can
    # write. Anything a caller sends is carried along and ignored.
    real_ip_recursive off;

    # Docker's embedded DNS. Without a resolver, nginx resolves upstream names once at
    # startup and keeps the address forever, so a restarted API container that comes
    # back on a new IP is unreachable until nginx is restarted too.
    resolver 127.0.0.11 valid=10s ipv6=off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /nginx-healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # The API's own health endpoint, exposed so an external uptime monitor can see
    # more than nginx being alive. Without this it falls through to the SPA and
    # returns 200 with index.html, which any monitor would read as healthy while the
    # API is down.
    location = /healthz {
        access_log off;
        proxy_pass http://meadow_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    # The live sessions feed. Its own block for one reason: it is an ordinary GET that
    # is never meant to finish, and the 60s read timeout below would cut it every
    # minute. The client would reconnect each time, so nothing would look broken - it
    # would just be a poll wearing a stream's clothes.
    #
    # Buffering is already off server-wide (see nginx.conf), and the response carries
    # `X-Accel-Buffering: no` as well, so this holds even if that ever changes.
    location = /api/v1/auth/sessions/stream {
        proxy_pass http://meadow_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $meadow_forwarded_proto;

        proxy_buffering off;
        proxy_cache off;
        # Matches the websocket block. The server sends a heartbeat every 20 seconds,
        # so an hour of silence here means a connection that is genuinely dead.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        proxy_pass http://meadow_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";

        # Replace, not append. $proxy_add_x_forwarded_for would carry through whatever
        # the client sent, and uvicorn's proxy-header middleware reads the leftmost
        # entry of the list, so a client could name its own address. After real_ip
        # processing above, $remote_addr is the true peer.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $meadow_forwarded_proto;

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location /ws/ {
        proxy_pass http://meadow_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $meadow_forwarded_proto;

        # ARCHITECTURE 8. A board with nobody typing sends nothing for long stretches,
        # and the 60s default would drop the socket out from under an idle tab. The
        # client would reconnect, but it would mint a fresh ws-token to do it, once a
        # minute, forever.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Vite fingerprints these, so the filename changes whenever the contents do.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # Self-hosted, versioned by hand, and changed roughly never.
    location /fonts/ {
        expires 30d;
        add_header Cache-Control "public" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # The app. Hash-routed, so /app is the only path it ever occupies: every route
    # under it - #/glade/<uuid>, #/reset/<token> - is a fragment the server never sees.
    # Two exact matches and no prefix location, which is what keeps this to one request.
    #
    # The obvious `location /app { try_files $uri $uri/ /app/index.html; }` does not
    # work here. /app is a real directory in the built output, and try_files redirects
    # whenever a name resolves to a directory - so /app answered 301 to /app/, built
    # from $scheme, which behind a TLS terminator is plain http. Naming the file
    # outright never matches a directory, so there is no redirect to get wrong.
    #
    # Both blocks repeat the server-level security headers on purpose: an add_header
    # anywhere in a location replaces the inherited set rather than adding to it, so
    # omitting them here would silently drop nosniff and the frame guard from the app.
    location = /app {
        try_files /app/index.html =404;

        # app/index.html names the fingerprinted bundles, so caching it is how a deploy
        # goes out and never arrives.
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location = /app/ {
        try_files /app/index.html =404;

        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Crawler files. Short cache rather than the HTML's no-cache: a search engine
    # refetches these on its own schedule and neither changes between deploys.
    location = /robots.txt {
        expires 1h;
        add_header Cache-Control "public" always;
        access_log off;
    }

    location = /sitemap.xml {
        expires 1h;
        add_header Cache-Control "public" always;
    }

    location / {
        # The landing page at /, and nothing else. `=404` rather than the SPA fallback
        # this used to have, and that is a deliberate SEO change: falling back to a 200
        # for every unknown path gives a crawler an unbounded supply of URLs that all
        # return the same page, which Google reports as soft 404s and treats as a sign
        # the site is thin. There are no path-based routes left to catch - the app is
        # hash-routed under /app - so a path that is not a file genuinely is missing.
        try_files $uri $uri/ =404;

        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
}
