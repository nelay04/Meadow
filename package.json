{
  "name": "meadow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "prepare": "[ -f scripts/install-hooks.mjs ] && node scripts/install-hooks.mjs || true",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:run": ".githooks/pre-commit",
    "check:staged": "node scripts/check-staged.mjs",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "gate": "node scripts/m0-gate.mjs",
    "bench:renderer": "node scripts/bench-renderer.mjs",
    "bench:canvas": "node scripts/canvas-perf.mjs",
    "bench:arrows": "node scripts/bench-arrows.mjs",
    "smoke:canvas": "node scripts/canvas-smoke.mjs",
    "smoke:overlay": "node scripts/overlay-smoke.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "e2e:board": "node scripts/board-e2e.mjs",
    "e2e:presence": "node scripts/presence-e2e.mjs",
    "check:stack": "node scripts/stack-check.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "ws": "^8.21.1",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.31"
  }
}
